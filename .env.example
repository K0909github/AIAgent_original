# Gemini API (get a key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: web-agent defaults (can also be passed via docker compose command)
WEB_AGENT_TASK=DuckDuckGoで '松尾研' を検索して
WEB_AGENT_MAX_STEPS=8
WEB_AGENT_START_URL=https://duckduckgo.com
